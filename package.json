{
  "name": "cooking-orchestrator-viewer",
  "private": true,
  "scripts": {
    "build:viewer": "node frontend/build.mjs",
    "typecheck": "tsc -p frontend/tsconfig.json",
    "build": "npm run typecheck && npm run build:viewer && .venv/bin/python scripts/serve_recipe_graphs.py --build-only",
    "dev": "npm run build:viewer && .venv/bin/python scripts/serve_recipe_graphs.py",
    "test:viewer": "npm run typecheck && npm run build:viewer && node --test tests/viewer-navigation.test.cjs"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "26.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.7"
  },
  "dependencies": {
    "@dagrejs/dagre": "1.1.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
