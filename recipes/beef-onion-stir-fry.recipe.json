{
  "$schema": "../schemas/recipe.schema.json",
  "schemaVersion": "1.0",
  "recipeId": "beef-onion-stir-fry",
  "name": "Beef Onion Stir-fry",
  "source": {
    "url": "https://thewoksoflife.com/beef-onion-stir-fry/",
    "publisher": "The Woks of Life",
    "author": "Sarah"
  },
  "servings": 4,
  "notes": [
    "US customary quantities. Each ingredient lists its portions; one generated measuring action per ingredient produces them, and portions are not duplicated inventory.",
    "Prep durations are planning estimates. Source timing ranges are preserved in duration fields or notes.",
    "Onion and sauce preparation are independent of marination. Complete both before starting the wok sequence.",
    "dependsOn preserves the source wok order without pretending equipment is a food state.",
    "Use the same wok and burner for the four cooking actions; a future scheduler must preserve that binding and account for resource occupancy between steps.",
    "Equipment names describe requirements, not the actual kitchen inventory. Cleaning and serving are outside this recipe.",
    "Suggested rice accompaniment is outside this graph and would need its own recipe graph.",
    "Outputs become available on confirmed action completion, not merely when an estimated timer expires. Initial ingredients must be available before their consuming actions start.",
    "The marination range records the recipe guidance; it is not a validated storage or safety limit.",
    "Measurement durations are generated planning estimates. Each measured portion stays separate until its consuming step; measuring shared across recipes is not yet scheduled."
  ],
  "outputs": ["finished_stir_fry"],
  "ingredients": {
    "flank_steak": {"name": "Flank steak", "portions": {"beef": {"quantity": 1, "unit": "lb"}}},
    "baking_soda": {"name": "Baking soda", "portions": {"marinade_baking_soda": {"quantity": 0.25, "unit": "tsp"}}},
    "cornstarch": {"name": "Cornstarch", "portions": {"marinade_cornstarch": {"quantity": 1, "unit": "tsp"}}},
    "neutral_oil": {
      "name": "Neutral oil",
      "portions": {
        "marinade_oil": {"quantity": 1, "unit": "tsp", "name": "Neutral oil for marinade"},
        "beef_searing_oil": {"quantity": 1, "unit": "tbsp", "name": "Neutral oil for searing beef"},
        "onion_searing_oil": {"quantity": 1, "unit": "tbsp", "name": "Neutral oil for searing onions"}
      }
    },
    "oyster_sauce": {
      "name": "Oyster sauce",
      "portions": {
        "marinade_oyster_sauce": {"quantity": 1, "unit": "tsp", "name": "Oyster sauce for marinade"},
        "sauce_oyster": {"quantity": 2, "unit": "tsp", "name": "Oyster sauce for sauce"}
      }
    },
    "water": {
      "name": "Water",
      "portions": {
        "marinade_water": {"quantity": 1, "unit": "tbsp", "name": "Water for marinade"},
        "sauce_water": {"quantity": 0.25, "unit": "cup", "name": "Water for sauce"}
      }
    },
    "light_soy_sauce": {"name": "Light soy sauce", "portions": {"sauce_light_soy": {"quantity": 1, "unit": "tbsp"}}},
    "dark_soy_sauce": {"name": "Dark soy sauce", "portions": {"sauce_dark_soy": {"quantity": 1, "unit": "tsp"}}},
    "ketchup": {"name": "Ketchup", "portions": {"sauce_ketchup": {"quantity": 2, "unit": "tsp"}}},
    "sugar": {"name": "Sugar", "portions": {"sauce_sugar": {"quantity": 0.25, "unit": "tsp"}}},
    "sesame_oil": {"name": "Sesame oil", "portions": {"sauce_sesame_oil": {"quantity": 0.25, "unit": "tsp"}}},
    "onion": {"name": "Small onions", "portions": {"onions": {"quantity": 10, "unit": "oz"}}}
  },
  "steps": [
    {
      "id": "slice_beef",
      "instruction": "Cut beef thinly across its fibers.",
      "duration": {
        "plannedSeconds": 300,
        "basis": "estimate",
        "note": "Estimated preparation time; the source lists beef already sliced."
      },
      "attention": "active",
      "cooksRequired": 1,
      "equipment": ["meat_knife", "meat_board"],
      "operation": "slice",
      "inputs": ["beef"],
      "outputs": [{"id": "sliced_beef", "name": "Sliced raw beef"}]
    },
    {
      "id": "mix_marinade",
      "instruction": "Work the marinade ingredients into the beef until absorbed.",
      "duration": {"plannedSeconds": 120, "basis": "estimate", "note": "Estimated mixing time."},
      "attention": "active",
      "cooksRequired": 1,
      "equipment": ["marinade_bowl"],
      "operation": "mix",
      "inputs": [
        "sliced_beef",
        "marinade_baking_soda",
        "marinade_cornstarch",
        "marinade_oil",
        "marinade_oyster_sauce",
        "marinade_water"
      ],
      "outputs": [{"id": "coated_beef", "name": "Beef mixed with marinade"}]
    },
    {
      "id": "marinate_beef",
      "instruction": "Let the coated beef marinate.",
      "duration": {"plannedSeconds": 900, "basis": "source", "minimumSeconds": 900, "maximumSeconds": 1800},
      "attention": "passive",
      "cooksRequired": 0,
      "equipment": ["marinade_bowl"],
      "operation": "marinate",
      "inputs": ["coated_beef"],
      "outputs": [{"id": "marinated_beef", "name": "Marinated raw beef"}]
    },
    {
      "id": "prep_onions",
      "instruction": "Peel onions and cut into wedges.",
      "duration": {
        "plannedSeconds": 180,
        "basis": "estimate",
        "note": "Estimated preparation time; the source lists onions already wedged."
      },
      "attention": "active",
      "cooksRequired": 1,
      "equipment": ["vegetable_knife", "vegetable_board"],
      "operation": "cut",
      "inputs": ["onions"],
      "outputs": [{"id": "onion_wedges", "name": "Onion wedges"}]
    },
    {
      "id": "mix_sauce",
      "instruction": "Combine the sauce ingredients.",
      "duration": {
        "plannedSeconds": 120,
        "basis": "estimate",
        "note": "Estimated mixing time; ingredient measurement is modeled separately."
      },
      "attention": "active",
      "cooksRequired": 1,
      "equipment": ["sauce_bowl"],
      "operation": "mix",
      "inputs": [
        "sauce_light_soy",
        "sauce_dark_soy",
        "sauce_ketchup",
        "sauce_oyster",
        "sauce_sugar",
        "sauce_sesame_oil",
        "sauce_water"
      ],
      "outputs": [{"id": "mixed_sauce", "name": "Mixed sauce"}]
    },
    {
      "id": "sear_beef",
      "instruction": "Heat wok on high to smoking; add oil. Spread beef flat, brown undisturbed for 30–60 seconds, then toss for 15–30 seconds. Transfer out partially cooked.",
      "duration": {
        "plannedSeconds": 150,
        "basis": "estimate",
        "note": "Estimated total including preheating, loading and transfer; source cooking phases total 45–90 seconds."
      },
      "attention": "active",
      "cooksRequired": 1,
      "equipment": ["wok", "burner", "spatula", "beef_holding_plate"],
      "dependsOn": ["prep_onions", "mix_sauce"],
      "operation": "sear",
      "inputs": ["marinated_beef", "beef_searing_oil"],
      "outputs": [{"id": "part_cooked_beef", "name": "Partially cooked beef held for finishing"}]
    },
    {
      "id": "sear_onions",
      "instruction": "Add oil and wedges to the same wok. Toss for 60–90 seconds until blistered; transfer out.",
      "duration": {
        "plannedSeconds": 105,
        "basis": "estimate",
        "note": "Estimated total including loading and transfer; source cooking time is 60–90 seconds."
      },
      "attention": "active",
      "cooksRequired": 1,
      "equipment": ["wok", "burner", "spatula", "onion_holding_plate"],
      "dependsOn": ["sear_beef"],
      "operation": "sear",
      "inputs": ["onion_wedges", "onion_searing_oil"],
      "outputs": [{"id": "seared_onions", "name": "Blistered onion wedges"}]
    },
    {
      "id": "simmer_sauce",
      "instruction": "Bring sauce to a simmer in the same wok; simmer for 15 seconds.",
      "duration": {
        "plannedSeconds": 45,
        "basis": "estimate",
        "note": "Estimated total includes reaching a simmer; the source specifies 15 seconds after simmering starts."
      },
      "attention": "active",
      "cooksRequired": 1,
      "equipment": ["wok", "burner", "spatula"],
      "dependsOn": ["sear_onions"],
      "operation": "simmer",
      "inputs": ["mixed_sauce"],
      "outputs": [{"id": "hot_sauce", "name": "Simmered sauce"}]
    },
    {
      "id": "finish_dish",
      "instruction": "Return beef and onions to the sauce; stir together for 30 seconds to finish cooking.",
      "duration": {"plannedSeconds": 30, "basis": "source"},
      "attention": "active",
      "cooksRequired": 1,
      "equipment": ["wok", "burner", "spatula"],
      "operation": "stir_fry",
      "inputs": ["part_cooked_beef", "seared_onions", "hot_sauce"],
      "outputs": [{"id": "finished_stir_fry", "name": "Beef and onion stir-fry"}]
    }
  ]
}
