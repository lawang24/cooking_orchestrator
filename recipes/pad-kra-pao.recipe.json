        "measure_sugar",
        "measure_fish_sauce",
        "measure_light_soy_sauce",
        "measure_dark_soy_sauce",
        "measure_oyster_sauce",
        "measure_low_sodium_chicken_broth",
        "measure_holy_basil"
      ]
