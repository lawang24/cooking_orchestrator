{
  "$schema": "../schemas/recipe.schema.json",
  "schemaVersion": "1.0",
  "recipeId": "pad-kra-pao",
  "name": "Pad Kra Pao (Pork and Holy Basil Stir-fry)",
  "servings": 4,
  "notes": [
    "Use Thai bird chilies with the seeds left in, low-sodium chicken broth for deglazing, and fresh holy basil leaves picked from the stems.",
    "The basil quantity is approximate and measured packed. The broth is 1/3 US cup, recorded as 16 tsp to represent the fraction exactly.",
    "Finish slicing and measuring before heating the wok so the cook can move straight from one stir-fry step to the next.",
    "Serve over separately cooked jasmine rice. Rice and the optional fried egg are outside this graph."
  ],
  "outputs": [
    "finished_pad_kra_pao"
  ],
  "ingredients": {
    "neutral_oil": {
      "name": "Vegetable oil",
      "quantity": 3,
      "unit": "tbsp"
    },
    "shallot": {
      "name": "Shallots",
      "quantity": 2,
      "unit": "whole"
    },
    "garlic": {
      "name": "Garlic cloves",
      "quantity": 7,
      "unit": "whole"
    },
    "thai_bird_chili": {
      "name": "Thai bird chilies",
      "quantity": 3,
      "unit": "whole"
    },
    "ground_pork": {
      "name": "Ground pork",
      "quantity": 1,
      "unit": "lb"
    },
    "sugar": {
      "name": "Sugar",
      "quantity": 1,
      "unit": "tsp"
    },
    "fish_sauce": {
      "name": "Fish sauce",
      "quantity": 1,
      "unit": "tbsp"
    },
    "light_soy_sauce": {
      "name": "Light soy sauce",
      "quantity": 1,
      "unit": "tbsp"
    },
    "dark_soy_sauce": {
      "name": "Dark soy sauce",
      "quantity": 2,
      "unit": "tsp"
    },
    "oyster_sauce": {
      "name": "Oyster sauce",
      "quantity": 2,
      "unit": "tsp"
    },
    "low_sodium_chicken_broth": {
      "name": "Low-sodium chicken broth",
      "quantity": 16,
      "unit": "tsp"
    },
    "holy_basil": {
      "name": "Fresh holy basil leaves (packed)",
      "quantity": 1.5,
      "unit": "cup"
    }
  },
  "steps": [
