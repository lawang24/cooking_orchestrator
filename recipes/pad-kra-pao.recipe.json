        "seasoning_dark_soy",
        "seasoning_oyster_sauce"
      ],
      "outputs": [
        {
          "id": "seasoned_pork",
          "name": "Seasoned pork"
        }
      ]
    },
    {
      "id": "deglaze_wok",
      "operation": "deglaze",
      "instruction": "Pour in the broth and scrape up the browned bits. Keep the heat high so the liquid cooks off quickly.",
