      "scheduled_duration_source": "estimate",
      "attention": "active",
      "cooksRequired": 1,
      "equipment": [
        "wok",
        "burner",
        "spatula"
      ],
      "inputs": [
        "seasoned_pork",
        "deglazing_broth"
      ],
      "outputs": [
