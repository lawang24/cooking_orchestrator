          "name": "Seasoned pork after deglazing"
        }
      ]
    },
    {
      "id": "wilt_basil",
      "operation": "stir_fry",
      "instruction": "Fold the holy basil into the pork and toss just until the leaves wilt.",
      "scheduled_duration_seconds": 30,
      "scheduled_duration_source": "estimate",
      "attention": "active",
      "cooksRequired": 1,
      "equipment": [
        "wok",
        "burner",
        "spatula"
      ],
      "inputs": [
        "deglazed_pork",
        "packed_basil"
      ],
      "outputs": [
        {
          "id": "finished_pad_kra_pao",
